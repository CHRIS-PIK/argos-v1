
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=aruba_reporting
DB_USER=aruba_ingestor
DB_PASSWORD=
DB_ROOT_PASSWORD=

LOG_LEVEL=INFO
WORKER_METRICS_PORT=9102
QUEUE_METRICS_INTERVAL_SECONDS=30
WORKER_POLL_SECONDS=2
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_SECONDS=30
QUEUE_LOCK_TIMEOUT_SECONDS=900
QUEUE_RECOVER_EVERY_SECONDS=60

# Ingest API
INGEST_MAX_ITEMS=5000

# ClickHouse (escrita dupla do worker; desligada por padrão)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=argos
