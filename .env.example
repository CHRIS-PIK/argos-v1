# Fila (Redis Streams)
REDIS_URL=redis://redis:6379/0

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=argos

LOG_LEVEL=INFO
WORKER_METRICS_PORT=9102
WORKER_BATCH_SIZE=10
WORKER_POLL_SECONDS=2
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_SECONDS=30
QUEUE_RECOVER_EVERY_SECONDS=30
QUEUE_METRICS_INTERVAL_SECONDS=30

# Ingest API
INGEST_MAX_ITEMS=5000

# Query API
EXPORT_DIRECT_LIMIT=50000
EXPORT_MAX_ROWS=1000000
EXPORT_TTL_SECONDS=86400
QUERY_MAX_SECONDS=30

# Portas publicadas no host
WEB_PORT=8090
INGEST_PORT=8000
QUERY_PORT=8001
